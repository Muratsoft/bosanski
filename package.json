{
  "name": "bosanski",
  "version": "0.1.0",
  "private": true,
  "description": "Boşnakça / BCS öğrenme platformu — NestJS API + web",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --workspace=api",
    "db:seed": "npm run prisma:seed --workspace=api"
  },
  "engines": {
    "node": ">=20"
  }
}
