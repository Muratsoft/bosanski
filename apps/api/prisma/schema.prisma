generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: migrate için pooler'sız (direct) URL. Yoksa DATABASE_URL kullanılır.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  SUPER_ADMIN
  MODERATOR
  TEACHER
  STUDENT
  MEMBER
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

/// BCS dil varyantı
enum LangVariant {
  COMMON
  BS
  HR
  SR
  CNR
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String?
  displayName     String
  role            Role          @default(MEMBER)
  status          AccountStatus @default(PENDING)
  provider        AuthProvider  @default(LOCAL)
  providerId      String?
  avatarUrl       String?
  phone           String?
  referralCode    String        @unique @default(cuid())
  referredById    String?
  referredBy      User?         @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]        @relation("Referrals")
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  passwordResets    PasswordResetToken[]
  refreshTokens     RefreshToken[]
  dictionaryEntries DictionaryEntry[]    @relation("DictionaryAuthor")
  lessons           Lesson[]             @relation("LessonAuthor")
  forumTopics       ForumTopic[]         @relation("TopicAuthor")
  forumEntries      ForumEntry[]         @relation("EntryAuthor")
  forumVotes        ForumVote[]
  forumReports      ForumReport[]        @relation("ReportAuthor")
  taughtEvents      CalendarEvent[]      @relation("EventTeacher")
  enrollments       CalendarEnrollment[]
  reminders         ReminderLog[]
  subscriptions     Subscription[]
  payments          Payment[]            @relation("PaymentUser")
  reviewedPayments  Payment[]            @relation("PaymentReviewer")
  paymentReminders  PaymentReminderLog[]
  aiConversations   AiConversation[]
  aiUsageDays       AiUsageDay[]
  gameScores        GameScore[]

  @@index([role])
  @@index([status])
  @@index([provider, providerId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  meta       String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model DictionaryEntry {
  id          String      @id @default(cuid())
  wordTr      String
  wordTarget  String
  variant     LangVariant @default(COMMON)
  phonetic    String?
  partOfSpeech String?
  exampleTr   String?
  exampleTarget String?
  notes       String?
  published   Boolean     @default(true)
  authorId    String?
  author      User?       @relation("DictionaryAuthor", fields: [authorId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([wordTr])
  @@index([wordTarget])
  @@index([variant])
  @@index([published])
}

model Category {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  published   Boolean    @default(true)
  lessons     Lesson[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([published])
  @@index([sortOrder])
}

model Lesson {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  summary     String?
  content     String?
  level       String     @default("A1")
  sortOrder   Int        @default(0)
  published   Boolean    @default(false)
  videoUrl    String?
  coverUrl    String?
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?      @relation("LessonAuthor", fields: [authorId], references: [id])
  media       LessonMedia[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([categoryId])
  @@index([published])
  @@index([level])
  @@index([sortOrder])
}

model LessonMedia {
  id        String    @id @default(cuid())
  lessonId  String
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type      MediaType
  url       String
  title     String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([lessonId])
}

model ForumTopic {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  authorId    String
  author      User         @relation("TopicAuthor", fields: [authorId], references: [id])
  locked      Boolean      @default(false)
  hidden      Boolean      @default(false)
  entryCount  Int          @default(0)
  lastEntryAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  entries     ForumEntry[]

  @@index([hidden])
  @@index([lastEntryAt])
  @@index([createdAt])
}

model ForumEntry {
  id        String        @id @default(cuid())
  topicId   String
  topic     ForumTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation("EntryAuthor", fields: [authorId], references: [id])
  body      String
  upvotes    Int           @default(0)
  downvotes  Int           @default(0)
  hidden    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  votes     ForumVote[]
  reports   ForumReport[]

  @@index([topicId])
  @@index([authorId])
  @@index([hidden])
  @@index([createdAt])
}

model ForumVote {
  id        String     @id @default(cuid())
  entryId   String
  entry     ForumEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime   @default(now())

  @@unique([entryId, userId])
  @@index([userId])
}

model ForumReport {
  id         String     @id @default(cuid())
  entryId    String
  entry      ForumEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User       @relation("ReportAuthor", fields: [reporterId], references: [id])
  reason     String
  resolved   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([entryId])
  @@index([resolved])
}

enum ReminderKind {
  LESSON_24H
  LESSON_1H
}

model CalendarEvent {
  id           String               @id @default(cuid())
  title        String
  description  String?
  startAt      DateTime
  endAt        DateTime
  meetUrl      String?
  calendarUrl  String?
  level        String?
  capacity     Int                  @default(20)
  published    Boolean              @default(true)
  teacherId    String?
  teacher      User?                @relation("EventTeacher", fields: [teacherId], references: [id])
  enrollments  CalendarEnrollment[]
  reminders    ReminderLog[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([startAt])
  @@index([published])
  @@index([teacherId])
}

model CalendarEnrollment {
  id        String        @id @default(cuid())
  eventId   String
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model ReminderLog {
  id        String        @id @default(cuid())
  eventId   String
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ReminderKind
  sentAt    DateTime      @default(now())

  @@unique([eventId, userId, kind])
  @@index([kind])
}

enum PlanInterval {
  MONTHLY
  QUARTERLY
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentReminderKind {
  PAYMENT_7D
  PAYMENT_3D
  PAYMENT_1D
}

model Plan {
  id                 String         @id @default(cuid())
  code               String         @unique
  name               String
  description        String?
  interval           PlanInterval
  durationMonths     Int
  priceTry           Int
  discountPercent    Int            @default(0)
  referralBonusDays  Int            @default(0)
  active             Boolean        @default(true)
  sortOrder          Int            @default(0)
  subscriptions      Subscription[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([active])
}

model Subscription {
  id               String                 @id @default(cuid())
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan                   @relation(fields: [planId], references: [id])
  status           SubscriptionStatus     @default(PENDING_PAYMENT)
  startsAt         DateTime?
  endsAt           DateTime?
  referralCodeUsed String?
  bonusDaysApplied Int                    @default(0)
  payments         Payment[]
  reminders        PaymentReminderLog[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([userId])
  @@index([status])
  @@index([endsAt])
}

model Payment {
  id             String         @id @default(cuid())
  subscriptionId String
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation("PaymentUser", fields: [userId], references: [id])
  amountTry      Int
  method         String         @default("BANK_TRANSFER")
  receiptUrl     String?
  note           String?
  status         PaymentStatus  @default(PENDING)
  reviewedById   String?
  reviewedBy     User?          @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  rejectReason   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([userId])
  @@index([subscriptionId])
}

model PaymentReminderLog {
  id             String              @id @default(cuid())
  subscriptionId String
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           PaymentReminderKind
  sentAt         DateTime            @default(now())

  @@unique([subscriptionId, userId, kind])
  @@index([kind])
}

enum AiMode {
  GENERAL
  LESSON
}

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  mode      AiMode      @default(GENERAL)
  level     String      @default("A1")
  variant   LangVariant @default(COMMON)
  lessonId  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId])
  @@index([mode])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

model AiUsageDay {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([day])
}

enum GameType {
  QUIZ
  FLASHCARD
  MATCH
}

model GameScore {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType    GameType
  score       Int
  total       Int
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([gameType])
  @@index([createdAt])
  @@index([score])
}
